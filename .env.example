# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# PostgreSQL JDBC connection (local database or Neon direct connection)
DB_URL=jdbc:postgresql://localhost:5432/obraia_dev
DB_USER=postgres
DB_PASSWORD=your_database_password

# Allowed frontend origins, separated by commas
FRONTEND_URL=http://localhost:5173
