# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# PostgreSQL JDBC connection (local database or Neon direct connection)
DB_URL=jdbc:postgresql://localhost:5432/obraia_dev
DB_USER=postgres
DB_PASSWORD=your_database_password

# Allowed frontend origins, separated by commas.
# The first one is used in the links sent by email.
FRONTEND_URL=http://localhost:5173

# Secret used to sign the access tokens: random text, at least 32 characters
JWT_SECRET=change_me_to_a_random_text_of_at_least_32_characters

# Emails: "log" writes them to the console (development); "brevo" sends them
MAIL_PROVIDER=log
MAIL_FROM=your_verified_sender@example.com
BREVO_API_KEY=

# Blueprints: "database" keeps the files in PostgreSQL; "local" in the uploads folder
STORAGE_PROVIDER=database

# AI service that reads the blueprints (obraia-ia). Leave the URL empty to turn it off.
# AI_SERVICE_TOKEN is the SERVICE_TOKEN of obraia-ia.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me
